# .env.example — copy to .env and fill

SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32

JWT_SECRET_KEY=change-me-must-differ-from-SECRET_KEY

DATABASE_URL=postgresql://user:password@host:5432/churchos

FRONTEND_URL=https://church-os-inky.vercel.app

FLASK_ENV=production

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox

FLW_SECRET_KEY=
FLW_SECRET_HASH=

# First admin only. 12+ characters. Remove after the admin exists.
ADMIN_BOOTSTRAP_PASSWORD=

# M-Pesa (Daraja). MPESA_CALLBACK_URL is the public address of this API, no trailing slash.
# MPESA_CALLBACK_SECRET: 24+ random characters; it becomes part of the callback address.
MPESA_CALLBACK_SECRET=
# Optional: comma-separated Safaricom IPs to enforce once you have confirmed them with Safaricom.
MPESA_ALLOWED_IPS=
